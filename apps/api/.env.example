# Safe configuration example. NEVER commit the corresponding .env.
# The local launcher generates database, RSA, Redis and S3 secrets in ignored .local/.
# AI: select gemini or groq, provide only its server-side key and a supported vision model.
# AI_API_KEY takes precedence. GROQ_API_KEY is used only for the Groq provider/base URL.
# UPCitemdb FREE: trial mode, no account/key/card; leave UPCITEMDB_API_KEY empty.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=À la Mode API
DATABASE_URL=
DATABASE_CA_FILE=
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WEATHER_PROVIDER=openmeteo
OPENWEATHERMAP_API_KEY=
AI_PROVIDER=openai_compatible
AI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4o-mini
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=alamode-media
S3_PRESIGN_TTL_SECONDS=600
MAX_UPLOAD_BYTES=10485760
PRODUCT_SEARCH_PROVIDERS=upcitemdb
UPCITEMDB_MODE=trial
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial
UPCITEMDB_API_KEY=
BARCODE_CACHE_TTL_SECONDS=86400
GEOCODING_BASE_URL=https://data.geopf.fr/geocodage
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
BCRYPT_LIKE_PEPPER=
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_ACCOUNT=5/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_BARCODE=30/minute
MAX_JSON_BODY_BYTES=262144
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=8192
APP_DEBUG=false
PUBLIC_API_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ACCOUNT_LINK_BASE_URL=
ALLOW_DEV_TOKENS=false
AUDIT_RETENTION_DAYS=90
WEATHER_RETENTION_DAYS=30
DRAFT_RETENTION_DAYS=7
SENTRY_DSN=
LOG_LEVEL=INFO
SENTRY_ENVIRONMENT=
SECURITY_ALERT_EMAIL=

# Docker infrastructure; generated for local use by scripts/local_runtime.py.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
POSTGRES_IMAGE=
REDIS_IMAGE=
MINIO_IMAGE=
POSTGRES_INIT_FILE=
API_ENV_FILE=

# Flutter defines (public settings only, never API provider keys).
API_BASE_URL=http://127.0.0.1:18000/api/v1
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_B64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
